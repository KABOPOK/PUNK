<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PUNK_JV" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="background">@color/strangeLowBlack</item>
        <item name="colorPrimary">@color/strangeBlack</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/strangeBlack</item>
        <item name="colorAccent">@color/strangeBlack</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:navigationBarColor">@color/strangeBlack</item>
    </style>
    <style name="MySearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="icon">@drawable/ic_search</item> // Custom search icon
        <item name="android:textColor">@color/strangeYellow</item> // Custom search icon
        <item name="android:textColorHint">@color/strangeLowBlack</item> // Custom search icon
        <item name="android:hint">"найти то, что искал"</item> // Custom search icon
    </style>
</resources>