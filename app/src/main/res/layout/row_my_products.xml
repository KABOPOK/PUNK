<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="286dp"
    android:background="#1E1E1E"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="245dp"
        android:layout_margin="15dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        app:cardCornerRadius="18dp"
        android:background="@color/strangeLowBlack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#292929">


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/row_image_ImageView"
                android:layout_width="132dp"
                android:layout_height="163dp"
                android:layout_marginStart="16dp"
                android:adjustViewBounds="true"
                android:background="@color/strangeLowBlack"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.804"
                app:shapeAppearanceOverlay="@style/ImageStyle" />

            <TextView
                android:id="@+id/row_productName_TextView"
                android:layout_width="250dp"
                android:layout_height="38dp"
                android:layout_marginTop="16dp"
                android:background="@color/strangeLowBlack"
                android:gravity="left"
                android:text="MULTIBAPKA"
                android:textColor="@color/strangeYellow"
                android:textColorHint="@color/white"
                android:textColorLink="@color/white"
                android:textSize="25sp"
                android:textStyle="bold"
                app:civ_border_color="@color/strangeYellow"
                app:civ_border_width="3dp"
                app:layout_constraintBottom_toTopOf="@+id/row_image_ImageView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.227"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="90dp"
                android:layout_height="25dp"
                android:layout_marginStart="156dp"
                android:layout_marginTop="68dp"
                android:gravity="center"
                android:text="Продаватель"
                android:background="@color/strangeLowBlack"
                android:textSize="12sp"
                android:textColor="@color/strangeYellow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="90dp"
                android:layout_height="25dp"
                android:gravity="center"
                android:layout_marginStart="156dp"
                android:layout_marginTop="16dp"
                android:background="@color/strangeLowBlack"
                android:text="стоимость"
                android:textColor="@color/strangeYellow"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />

            <TextView
                android:layout_width="90dp"
                android:layout_height="25dp"
                android:layout_marginStart="156dp"
                android:background="@color/strangeLowBlack"
                android:text="проблемки"
                android:gravity="center"
                android:textColor="@color/strangeYellow"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView"
                app:layout_constraintVertical_bias="0.127" />

            <TextView
                android:id="@+id/row_userName_TextView"
                android:layout_width="90dp"
                android:layout_height="25dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="68dp"
                android:background="@color/strangeLowBlack"
                android:gravity="center"
                android:hint="UserName"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.826"
                app:layout_constraintStart_toEndOf="@+id/row_image_ImageView"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/row_productPrice_TextView"
                android:layout_width="90dp"
                android:layout_height="25dp"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="109dp"
                android:layout_marginTop="40dp"
                android:background="@color/strangeLowBlack"
                android:gravity="center"
                android:text="price"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.285"
                app:layout_constraintStart_toEndOf="@+id/row_image_ImageView"
                app:layout_constraintTop_toTopOf="@+id/row_userName_TextView" />

            <TextView
                android:id="@+id/row_productInfo_TextView"
                android:layout_width="170dp"
                android:layout_height="49dp"
                android:background="@color/strangeLowBlack"
                android:gravity="center"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.609"
                app:layout_constraintStart_toEndOf="@+id/row_image_ImageView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.867" />

            <ImageView
                android:id="@+id/trashCase"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_vector_thash_case"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>