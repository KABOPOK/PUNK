<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/registrationUserPhoto_ImageView"
        android:layout_width="wrap_content"
        android:layout_height="222dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="68dp"
        android:layout_marginTop="49dp"
        android:layout_marginEnd="68dp"
        app:srcCompat="@drawable/ic_photo"
        tools:srcCompat="@drawable/ic_photo" />

    <EditText
        android:id="@+id/create_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="305dp"
        android:layout_marginRight="25dp"
        android:hint="имя"
        android:inputType="textPersonName"
        android:padding="15dp" />

    <EditText
        android:id="@+id/create_gender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="500dp"
        android:layout_marginRight="25dp"
        android:hint="пол"
        android:inputType="textPersonName"
        android:padding="15dp" />

    <EditText
        android:id="@+id/create_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="435dp"
        android:layout_marginRight="25dp"
        android:hint="телефон"
        android:inputType="phone"
        android:padding="15dp" />

    <EditText
        android:id="@+id/create_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="370dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="95dp"
        android:hint="Пapoль"
        android:inputType="textPersonName"
        android:padding="15dp" />

    <CheckBox
        style="@style/Material.Drawable.CheckBox"
        android:layout_width="299dp"
        android:layout_height="37dp"
        android:layout_above="@+id/create_new_user_button"
        android:id="@+id/checkRegistration_CheckBox"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="131dp"
        android:layout_marginEnd="107dp"
        android:layout_marginBottom="21dp"
        android:text="Погожев всегда прав"
        android:textAllCaps="false"
        android:textSize="20dp" />

    <Button
        android:id="@+id/create_new_user_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="9dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="17dp"
        android:onClick="displayClick"
        android:padding="20dp"
        android:text="penetration to base"
        android:textColor="@color/white"
        android:textSize="30dp" />
</RelativeLayout>