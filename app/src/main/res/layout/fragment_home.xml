<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/strangeBlack"
    tools:context=".fragments.HomeFragment">
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigationViewUp"
        style="@style/Widget.MaterialComponents.BottomNavigationView.PrimarySurface"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#1e1e1e"
        app:itemActiveIndicatorStyle="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/searchView2"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:textCursorDrawable="@drawable/custon_cursor"
        android:background="@color/strangeBlack"
        android:hint="           найти то, что искал"
        android:textColor="@color/white"
        android:textColorHint="#CAC6C6"
        app:layout_constraintEnd_toStartOf="@+id/circleImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationViewUp" />

    <ImageView
        android:id="@+id/circleImageView"
        android:layout_width="68dp"
        android:layout_height="43dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_black_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationViewUp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/strangeBlack"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/navigationViewDown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchView2" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigationViewDown"
        style="@style/Widget.MaterialComponents.BottomNavigationView.PrimarySurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1e1e1e"
        app:itemActiveIndicatorStyle="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>